{
  "name": "project-tracing",
  "version": "1.0.0",
  "description": "CLI to track upstream projects: version endpoints (GET + JSON/plain) and Git commits since a baseline; produces daily Markdown and JSON reports.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "trace": "tsx src/index.ts",
    "feed": "tsx src/feed.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tracing",
    "changelog",
    "version",
    "semver",
    "git",
    "monitoring",
    "i18n"
  ],
  "author": "Herbert He <Herbert.He0229@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "ajv": "^8.18.0"
  }
}
